MODEL_PROVIDER=mock

# Shared secret guarding every /v1 route. Unset leaves the gateway open, which
# is right on localhost and wrong on a public port — one analysis spends the
# operator's model quota. `docker-compose.yml` refuses to start without it.
# Generate one with: openssl rand -hex 32
GATEWAY_API_KEY=

# Ordered nutrition lookup; the first exact name match wins.
#
# Keep `local` last. It holds two tables: dishes with a recipe, which come back
# cited to USDA rows, and the older hand-written rows, which come back with
# nutritionIsReference=true because their figures are asserted rather than
# measured.
#
# `openfoodfacts` is worth having and costs nothing but a User-Agent — measured,
# it takes a non-Vietnamese corpus from 10% resolved to 67%. **Keep it behind
# `usda`**: it is a database of *packaged products*, so an exact name match
# returns one barcode's figures rather than the dish's. It reads watermelon at
# 31 kcal/100 g and "Fried Chicken" at 536, which is a snack, not a dish. It
# cannot help Vietnamese food at all — phở is not a barcoded product.
NUTRITION_SOURCES=usda,openfoodfacts,local
USDA_API_KEY=
OPENFOODFACTS_USER_AGENT=HeathFirst/0.1 (contact@example.com)

# Recognition providers. Configure only the provider you run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-vl-7b-instruct
