MODEL_PROVIDER=mock

# Shared secret guarding every /v1 route. Unset leaves the gateway open, which
# is right on localhost and wrong on a public port — one analysis spends the
# operator's model quota. `docker-compose.yml` refuses to start without it.
# Generate one with: openssl rand -hex 32
GATEWAY_API_KEY=

# Ordered nutrition lookup; the first exact name match wins, so the order is
# a statement about which kind of answer you trust more.
#
# `derived`   dishes with a recipe in recipes.py, computed from CC0 USDA rows.
#             **First.** For a dish the app has a recipe for, nothing beats it.
# `usda`      measured ingredient data, public domain. Needs a key.
# `openfoodfacts`  packaged products. Free — only a User-Agent. Worth having:
#             it took a non-Vietnamese corpus from 10% resolved to 67%.
# `reference` the older hand-written rows, returned with
#             nutritionIsReference=true. **Last**, because they are asserted
#             rather than measured.
#
# `local` is `derived` then `reference` at one position, which is right for a
# localhost gateway with no keys and wrong for anything with network sources.
#
# **The order below is not cosmetic.** Under `usda,openfoodfacts,local` a
# deployed gateway resolved a 400 g bowl of phở to a packet of Shan Noodle
# instant soup — a genuine Open Food Facts product named "Beef Pho" at
# 367 kcal/100 g — and reported 1,467 kcal, because the barcode was consulted
# before the recipe.
NUTRITION_SOURCES=derived,usda,openfoodfacts,reference
USDA_API_KEY=
OPENFOODFACTS_USER_AGENT=HeathFirst/0.1 (contact@example.com)

# Recognition providers. Configure only the provider you run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-vl-7b-instruct

# --- Spending limits ---------------------------------------------------------
#
# Authentication decides *whether* a caller may spend the operator's model
# quota. These decide *how much*, which is the question that survives the key
# leaking — and it will: `GATEWAY_API_KEY` is one shared secret inside an iOS
# bundle. Details and the reasoning behind where each is enforced live in
# `app/rate_limit.py`.
#
# Per client address, per rolling minute. Generous for a person photographing a
# meal, three orders of magnitude below what a script does. `0` = no limit.
RATE_LIMIT_PER_MINUTE=10
# Calls to any one model per rolling 24h, counted per provider because the free
# tier's quota is. This is the limit that matters: a provider 429 is *not*
# transient — it resets at midnight Pacific and the app is dead until then. Set
# it **below** whatever your key actually has; published free-tier numbers are
# revised without notice, so this is a guard, not a mirror of them. `0` = no limit.
RATE_LIMIT_PER_DAY=200

# --- TLS (docker compose --profile tls) --------------------------------------
#
# A domain, not an IP. No CA issues a certificate for an address, which is the
# whole reason plain `http://<ip>:8000` is a stopgap and why the iOS client
# needs an App Transport Security exception without this. Point an A record at
# the VPS and open 80 and 443 before the first start: Caddy proves control of
# the name over port 80.
GATEWAY_DOMAIN=

# Uncomment both **only together with** the `tls` profile. Loopback stops
# publishing 8000 to the world (Caddy reaches the gateway over the compose
# network regardless), and that is precisely what makes believing
# `X-Forwarded-For` sound — with the port publicly reachable a caller writes
# their own value and picks a fresh rate-limit allowance per request.
#GATEWAY_BIND=127.0.0.1
#TRUST_PROXY_HEADERS=1
