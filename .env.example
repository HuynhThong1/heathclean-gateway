MODEL_PROVIDER=mock

# Shared secret guarding every /v1 route. Unset leaves the gateway open, which
# is right on localhost and wrong on a public port — one analysis spends the
# operator's model quota. `docker-compose.yml` refuses to start without it.
# Generate one with: openssl rand -hex 32
GATEWAY_API_KEY=

# Ordered nutrition lookup; the first exact name match wins, so the order is
# a statement about which kind of answer you trust more.
#
# `derived`   dishes with a recipe in recipes.py, computed from CC0 USDA rows.
#             **First.** For a dish the app has a recipe for, nothing beats it.
# `usda`      measured ingredient data, public domain. Needs a key.
# `openfoodfacts`  packaged products. Free — only a User-Agent. Worth having:
#             it took a non-Vietnamese corpus from 10% resolved to 67%.
# `reference` the older hand-written rows, returned with
#             nutritionIsReference=true. **Last**, because they are asserted
#             rather than measured.
#
# `local` is `derived` then `reference` at one position, which is right for a
# localhost gateway with no keys and wrong for anything with network sources.
#
# **The order below is not cosmetic.** Under `usda,openfoodfacts,local` a
# deployed gateway resolved a 400 g bowl of phở to a packet of Shan Noodle
# instant soup — a genuine Open Food Facts product named "Beef Pho" at
# 367 kcal/100 g — and reported 1,467 kcal, because the barcode was consulted
# before the recipe.
NUTRITION_SOURCES=derived,usda,openfoodfacts,reference
USDA_API_KEY=
OPENFOODFACTS_USER_AGENT=HeathFirst/0.1 (contact@example.com)

# Recognition providers. Configure only the provider you run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-vl-7b-instruct
